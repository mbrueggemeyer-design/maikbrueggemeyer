---
import "../styles/global.css";
import Sidebar from "../components/Sidebar.astro";

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "https://maikbrueggemeyer.de/#person",
  name: "Maik Brüggemeyer",
  url: "https://maikbrueggemeyer.de/",
  jobTitle: ["Autor", "Kulturjournalist", "Creative Director"],
  worksFor: {
    "@type": "Organization",
    name: "Rolling Stone Deutschland",
    url: "https://www.rollingstone.de/",
  },
  knowsAbout: [
    "Popmusik",
    "Literatur",
    "Film",
    "Popkultur",
    "Musikjournalismus",
  ],
};

interface Props {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title = "Maik Brüggemeyer",
  description = "Geschichten zwischen Pop, Literatur, Film und Gesellschaft.",
  structuredData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Maik Brüggemeyer – Wohnzimmer"
      href="/rss.xml"
    />

<link rel="canonical" href={canonicalURL.toString()} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    ></script>

    {
      structuredData && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(structuredData)}
        ></script>
      )
    }
  </head>

  <body>
    <div class="site-shell">
      <Sidebar />

      <main class="site-main">
        <slot />
      </main>
    </div>
  </body>
</html>

<style>
  .site-shell {
    display: grid;
    grid-template-columns: var(--sidebar-width) minmax(0, 1fr);
    min-height: 100vh;
  }

  .site-main {
    min-width: 0;
  }

  @media (max-width: 800px) {
    .site-shell {
      display: block;
    }
  }
</style>