---
import BaseLayout from "../layouts/BaseLayout.astro";
import { archive } from "../data/archive";

const featuredIds = [
  "warum-die-deutschen-david-hasselhoff-liebten",
  "triumph-des-krisenvogels",
  "kann-man-ueber-architektur-tanzen",
];

const latest = featuredIds
  .map((id) => archive.find((entry) => entry.id === id))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
---

<BaseLayout
  title="Maik Brüggemeyer - Autor und Journalist"
  description="Website von Maik Brüggemeyer, Autor und Kulturjournalist. Bücher, Essays, Gespräche, Podcast, ROLLING STONE Wohnzimmer und Termine."
>

<section class="hero">

  <div class="hero-inner">

<p class="name">
  Maik Brüggemeyer
</p>

<h1>
  Notizen zur<br />
  Geschichte der<br />
  Gegenwart.
</h1>

  </div>

</section>

<section class="intro-copy">
  <p>
    Ich schreibe{" "}
    <a href="/buecher">Romane und Sachbücher</a>, mache{" "}
    <a href="/podcast">Podcasts</a>,
    {" "} veröffentliche{" "}
    <a href="/wohnzimmer">Newsletter</a>
    {" "}und arbeite als Creative Director beim <em>Rolling Stone</em>. 
    Auf dieser Seite finden sich einige ausgewählte Arbeiten zu Musik,
    Literatur, Film und Popkultur im weiteren Sinne.
  </p>
</section>

<section class="archive">

  <div class="entries">

    {
      latest.map((entry) => (

        <article>

          <h3>{entry.title}</h3>

          <p>{entry.teaser}</p>

          <a href={entry.url}>
            Lesen →
          </a>

        </article>

      ))
    }

  </div>

</section>

</BaseLayout>

<style>

.hero{

  min-height: 80vh;
  display: flex;
  align-items: center;
  padding: 8rem var(--page-padding) 10rem;
  border-bottom: 1px solid var(--color-border);

}

.hero-inner{

max-width:900px;

}

.name{

font-family:var(--font-sans);

font-size:.72rem;

letter-spacing:.35em;

text-transform:uppercase;

margin-bottom:4rem;

color:var(--color-muted);

}

h1{

margin:0;

font-size:clamp(4.5rem,8vw,8rem);

font-weight:400;

line-height:.9;

letter-spacing:-.05em;


}
.intro-copy {
  padding: 3rem var(--page-padding);
  border-bottom: 1px solid var(--color-border);
}

.intro-copy p {
  max-width: 44rem;
  margin: 0;
  font-size: 1.05rem;
  line-height: 1.65;
  color: var(--color-muted);
}

.intro-copy a {
  color: inherit;
  text-decoration: underline;
  text-decoration-thickness: 1px;
  text-underline-offset: 0.18em;
}

.intro-copy a:hover {
  color: var(--color-text);
}

.archive{

display:block;

}

.entries{

display:grid;

grid-template-columns:repeat(3,1fr);

}

.entries article{

padding:2.5rem;

border-right:1px solid var(--color-border);

min-height:300px;

display:flex;

flex-direction:column;

}

.entries article:last-child{

border-right:none;

}


h3{

font-size:1.8rem;

font-weight:400;

line-height:1.1;

margin-bottom:1rem;

}

.entries article p:not(.meta){

line-height:1.6;

margin-bottom:auto;

}

.entries a {
  margin-top: 2rem;
  font-family: "Newsreader", Georgia, serif;
  font-size: 1rem;
}

@media(max-width:900px){

.hero{

padding:4rem 1.5rem;

min-height:auto;

}

.intro-copy {
  padding: 2.5rem 1.5rem;
}

.intro-copy p {
  font-size: 1.2rem;
}

.archive{

grid-template-columns:1fr;

}

.archive-title{

border-right:none;

border-bottom:1px solid var(--color-border);

}

.entries{

grid-template-columns:1fr;

}

.entries article{

border-right:none;

border-bottom:1px solid var(--color-border);

min-height:auto;

}

.entries article:last-child{

border-bottom:none;

}

}

</style>