---
import BaseLayout from "../layouts/BaseLayout.astro";
import {
  getCollection,
  type CollectionEntry,
} from "astro:content";

type WohnzimmerEntry = CollectionEntry<"wohnzimmer">;

const issues: WohnzimmerEntry[] = (await getCollection("wohnzimmer"))
  .sort(
    (a: WohnzimmerEntry, b: WohnzimmerEntry) =>
      b.data.issue - a.data.issue
  )
  .slice(0, 7);
---

<BaseLayout
  title="Wohnzimmer – Maik Brüggemeyer"
  description="Briefe zur Geschichte der Gegenwart."
>
  <header class="page-header">
    <h1>Wohnzimmer</h1>

<p class="introduction">
  Alle zwei Wochen schreibe ich für den{" "}
  <em>Rolling Stone</em> den Newsletter <strong>ROLLING STONE Wohnzimmer</strong> über
  Musik, Bücher, Kultur und alles, was mich gerade beschäftigt. Hier findet
  sich eine Auswahl älterer Ausgaben. Abonnieren kann man ihn{" "}
  <a
    href="https://www.rollingstone.de/wohnzimmer/"
    target="_blank"
    rel="noopener noreferrer"
  >hier</a>.
</p>

  </header>

  <section class="archive">
    <div class="entry-list">
      {
        issues.length > 0 ? (
          issues.map((entry) => (
            <article>
              <p class="issue-number">
                {entry.data.issue}
              </p>

              <div class="meta">
                {new Intl.DateTimeFormat("de-DE", {
                  day: "numeric",
                  month: "long",
                  year: "numeric",
                }).format(entry.data.date)}
              </div>

              <div class="entry-copy">
                <h2>{entry.data.title}</h2>

                {
                  entry.data.teaser && (
                    <p>{entry.data.teaser}</p>
                  )
                }
              </div>

              <a
                href={`/wohnzimmer/${entry.id}`}
                aria-label={`Wohnzimmer-Ausgabe öffnen: ${entry.data.title}`}
              >
                Lesen <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        ) : (
          <div class="empty">
            <p>Es sind noch keine Wohnzimmer-Ausgaben eingetragen.</p>
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    min-height: 55vh;
    padding: 7rem var(--page-padding) 5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    margin: 0;
    font-size: clamp(4.5rem, 10vw, 9rem);
    font-weight: 400;
    line-height: 0.88;
    letter-spacing: -0.05em;
  }

  .introduction {
    max-width: 46rem;
    margin: 3rem 0 0;
    color: var(--color-muted);
    font-size: 1.45rem;
    line-height: 1.5;
  }

  .archive {
    padding: 6rem var(--page-padding);
    border-bottom: 1px solid var(--color-border);
  }

  .entry-list {
    border-top: 1px solid var(--color-border);
  }

  article {
    padding: 3rem 0;
    display: grid;
    grid-template-columns:
      120px
      180px
      minmax(0, 1fr)
      100px;
    gap: 2rem;
    align-items: start;
    border-bottom: 1px solid var(--color-border);
  }

  .issue-number {
    margin: -0.15em 0 0;
    color: var(--color-muted);
    font-family: "Newsreader", Georgia, serif;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
  }

  .meta {
    color: var(--color-muted);
    font-family: "Newsreader", Georgia, serif;
    font-size: 0.95rem;
    line-height: 1.35;
  }

  .entry-copy h2 {
    margin: 0 0 0.8rem;
    font-size: clamp(2rem, 3vw, 3rem);
    font-weight: 400;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .entry-copy p {
    max-width: 54ch;
    margin: 0;
    color: var(--color-muted);
    line-height: 1.55;
  }

  article > a {
    display: flex;
    justify-content: space-between;
    gap: 0.8rem;
    font-family: "Newsreader", Georgia, serif;
    font-size: 1rem;
  }

  .empty {
    padding: 2rem 0;
    color: var(--color-muted);
  }

  .empty p {
    margin: 0;
  }

  @media (max-width: 900px) {
    .page-header {
      min-height: auto;
      padding: 5rem 1.5rem 4rem;
    }

    .archive {
      padding: 4rem 1.5rem;
    }

    article {
      grid-template-columns: 60px minmax(0, 1fr);
      gap: 1rem;
    }

    .issue-number {
      font-size: 2rem;
    }

    .meta,
    .entry-copy,
    article > a {
      grid-column: 2;
    }

    article > a {
      width: fit-content;
    }
  }
</style>