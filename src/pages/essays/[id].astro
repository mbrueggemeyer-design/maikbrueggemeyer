---
import BaseLayout from "../../layouts/BaseLayout.astro";
import {
  getCollection,
  render,
  type CollectionEntry,
} from "astro:content";

export const prerender = true;

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay: CollectionEntry<"essays">) => ({
    params: {
      id: essay.id,
    },
    props: {
      essay,
    },
  }));
}

interface Props {
  essay: CollectionEntry<"essays">;
}

const { essay } = Astro.props;
const { Content } = await render(essay);

const formattedDate = new Intl.DateTimeFormat("de-DE", {
  year: "numeric",
}).format(essay.data.date);
---

<BaseLayout
  title={`${essay.data.title} – Maik Brüggemeyer`}
  description={essay.data.teaser}
>
  <article class="essay">
    <header class="essay-header">
      <p class="kicker">
        Essay · {essay.data.topic}
      </p>

      <h1>{essay.data.title}</h1>

      <p class="teaser">
        {essay.data.teaser}
      </p>

      <div class="meta">
        <span>{essay.data.publication}</span>
        <span>{formattedDate}</span>
      </div>
    </header>

    <section class="essay-body">
      <Content />
    </section>

    <footer class="essay-footer">
      <a href="/texte">
        <span aria-hidden="true">←</span>
        Zurück zu den Essays
      </a>
    </footer>
  </article>
</BaseLayout>

<style>
  .essay {
    min-height: 100vh;
  }

  .essay-header {
    min-height: 72vh;
    padding: 7rem var(--page-padding) 5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-bottom: 1px solid var(--color-border);
  }

  .kicker {
    margin: 0 0 1.5rem;
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 500;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  h1 {
    max-width: 11em;
    margin: 0;
    font-size: clamp(3.8rem, 8vw, 8rem);
    font-weight: 400;
    line-height: 0.9;
    letter-spacing: -0.05em;
  }

  .teaser {
    max-width: 43rem;
    margin: 3rem 0 0;
    color: var(--color-muted);
    font-size: 1.95rem;
line-height: 1.45;
max-width: 32em;
  }

  .meta {
    margin-top: 3rem;
    padding-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-family: var(--font-sans);
    font-size: 0.74rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .essay-body {
    width: min(100% - 3rem, 760px);
    margin: 0 auto;
    padding: 7rem 0 8rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.65em;
    line-height: 1.85;
    color: var(--color-text);
  }

  .essay-body :global(p) {
    margin: 0 0 1.6em;
  }

  .essay-body :global(p:first-of-type) {
    font-size: 1.95rem;
    line-height: 1.55;
    color: var(--color-text);
  }

  .essay-body :global(p:first-of-type::first-letter) {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-size: 5.8rem;
    font-weight: 400;
    line-height: 0.82;
  }

  .essay-body :global(h2) {
    margin: 3em 0 1em;
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .essay-body :global(h3) {
    margin: 2.4em 0 0.8em;
    font-size: 2rem;
    font-weight: 400;
    line-height: 1.1;
  }

  .essay-body :global(blockquote) {
    margin: 3rem 0;
    padding-left: 2rem;
    border-left: 2px solid var(--color-border);
    font-size: 1.45rem;
    font-style: italic;
    line-height: 1.7;
  }

  .essay-body :global(ul),
  .essay-body :global(ol) {
    margin: 2rem 0;
    padding-left: 2rem;
  }

  .essay-body :global(li) {
    margin-bottom: 0.6em;
  }

  .essay-body :global(a) {
    border-bottom: 1px solid var(--color-border);
  }

  .essay-body :global(img) {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 3rem auto;
  }

  .essay-body :global(hr) {
    width: 80px;
    margin: 5rem auto;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .essay-footer {
    padding: 2rem var(--page-padding) 5rem;
    border-top: 1px solid var(--color-border);
  }

  .essay-footer a {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    font-family: var(--font-sans);
    font-size: 0.85rem;
  }

  @media (max-width: 900px) {
    .essay-header {
      min-height: auto;
      padding: 5rem 1.5rem 4rem;
    }

    h1 {
      font-size: clamp(3.2rem, 12vw, 5.8rem);
    }

    .essay-body {
      width: min(100% - 3rem, 760px);
      padding: 4rem 0 5rem;
      font-size: 1.08rem;
      line-height: 1.75;
    }

    .essay-body :global(p:first-of-type) {
      font-size: 1.35rem;
    }

    .essay-body :global(p:first-of-type::first-letter) {
      font-size: 4.5rem;
    }

    .essay-body :global(h2) {
      font-size: 2.2rem;
    }

    .essay-body :global(h3) {
      font-size: 1.7rem;
    }

    .essay-footer {
      padding: 2rem 1.5rem 4rem;
    }
  }
</style>