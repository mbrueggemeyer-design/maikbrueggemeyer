---
import BaseLayout from "../layouts/BaseLayout.astro";

const books = [
 {
  type: "Roman",
  title: "Wie jeder weiß, ist das hier das Nirgendwo",
  publication: "Ventil Verlag",
  year: "2026",
  teaser: "Ein Roman über Herkunft und die Versprechen der Popkultur.",
  url: "/buecher/nirgendwo",
},
{
  type: "Roman",
  title: "Catfish",
  publication: "Metrolit Verlag",
  year: "2015",
  teaser: "Ein Bob-Dylan-Roman.",
  url: "/buecher/catfish",
},
{
  type: "Roman",
  title: "Das Da-Da-Da-Sein",
  publication: "Aufbau Verlag",
  year: "2011",
  teaser: "Sein und Pop.",
  url: "/buecher/dada",
},
{
  type: "Sachbuch",
  title: "Schöner kann es gar nicht sein",
  publication: "Andreas Reiffer Verlag",
  year: "2021",
  teaser: "The Beatles von 1957 bis 1970.",
  url: "/buecher/schoener",
},
{
  type: "Sachbuch",
  title: "Pop. Eine Gebrauchsanweisung",
  publication: "Penguin Verlag",
  year: "2019",
  teaser: "Fragen und Antworten zu Pop.",
  url: "/buecher/pop",
},
{
  type: "Sachbuch",
  title: "I've Been Looking For Frieden",
  publication: "Penguin Verlag",
  year: "2018",
  teaser: "Eine (bundes-)deutsche Geschichte in zehn Songs.",
  url: "/buecher/frieden",
},
{
  type: "Anthologie",
  title: "Look Out Kid",
  publication: "Ullstein Verlag",
  year: "2021",
  teaser: "Bob Dylans Lieder, unsere Geschichten.",
  url: "/buecher/lookoutkid",
},
];
---

<BaseLayout
  title="Bücher – Maik Brüggemeyer"
  description="Romane und Sachbücher von Maik Brüggemeyer."
>
  <header class="page-header">
    <h1>Bücher</h1>

    <p class="introduction">
      Romane und Sachbücher über Popmusik, Herkunft, Erinnerung und
      kulturelle Gegenwart.
    </p>
  </header>

  <main class="books">
    {
      books.map((book) => (
       
<article class="book-entry">
  <p class="type">{book.type}</p>

  <h2>
    {book.url ? (
      <a href={book.url}>{book.title}</a>
    ) : (
      book.title
    )}
  </h2>

  <p class="meta">
    {book.publication} · {book.year}
  </p>

  <p class="teaser">{book.teaser}</p>

  {book.url && (
    <a
      class="book-link"
      href={book.url}
      aria-label={`Werkseite öffnen: ${book.title}`}
    >
      Werkseite <span aria-hidden="true">→</span>
    </a>
  )}
</article>

      ))
    }
  </main>
</BaseLayout>

<style>
  .page-header {
    min-height: 48vh;
    padding: 7rem var(--page-padding) 5rem;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    border-bottom: 1px solid var(--color-border);
  }

  h1 {
    margin: 0;
    font-size: clamp(5rem, 11vw, 10rem);
    font-weight: 400;
    line-height: 0.85;
    letter-spacing: -0.055em;
  }

  .introduction {
    max-width: 44rem;
    margin: 3rem 0 0;
    color: var(--color-muted);
    font-size: 1.45rem;
    line-height: 1.5;
  }

  .books {
    padding: 4rem var(--page-padding) 7rem;
  }

  .book-entry {
  max-width: 760px;
  padding: 3.5rem 0;
  border-bottom: 1px solid var(--color-border);
}
  .book-entry:first-child {
    border-top: 1px solid var(--color-border);
  }

.type {
  margin: 0 0 1.6rem;
  color: var(--color-muted);
  font-family: var(--font-sans);
  font-size: 0.72rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

  .book-main {
    min-width: 0;
  }

  h2 {
    max-width: 17em;
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 4.3rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  h2 a {
    color: inherit;
    text-decoration: none;
  }

  h2 a:hover {
    opacity: 0.65;
  }

  .meta {
    margin: 1.25rem 0 0;
    color: var(--color-muted);
    font-family: "Newsreader", Georgia, serif;
    font-size: 1rem;
    line-height: 1.45;
  }

.teaser {
  max-width: 48ch;
  margin: 1.25rem 0 0;
  color: var(--color-muted);
  font-size: 1.45rem;
  line-height: 1.45;
}

  .book-link {
  display: inline-flex;
  gap: 1rem;
  margin-top: 1.75rem;
  color: var(--color-text);
  font-family: var(--font-sans);
  font-size: 0.76rem;
  letter-spacing: 0.08em;
  text-decoration: none;
  text-transform: uppercase;
}

  .book-link:hover {
    opacity: 0.65;
  }

  @media (max-width: 900px) {
    .page-header {
      min-height: auto;
      padding: 5rem 1.5rem 4rem;
    }

    .books {
      padding: 3rem 1.5rem 5rem;
    }

    .book-entry {
      padding: 2.5rem 0;
    
    }

    h2 {
      font-size: clamp(2.3rem, 10vw, 3.7rem);
    }

    .book-link {
      justify-self: start;
      margin-top: 0.75rem;
    }
  }
</style>