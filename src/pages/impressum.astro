---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Impressum – Maik Brüggemeyer"
  description="Impressum."
>

<section class="hero">

  <h1>Impressum</h1>

</section>

<section class="content">

  <section class="block">

    <h2>Angaben gemäß § 5 TMG</h2>

    <p>
      Maik Brüggemeyer<br />
      c/o Mediahouse Berlin GmbH<br />
      Mehringdamm 33<br />
      10961 Berlin <br />

      Deutschland
    </p>

  </section>

  <section class="block">

    <h2>Kontakt</h2>

    <p>
      E-Mail:
      <a href="mailto:m.brueggemeyer@googlemail.com">
        m.brueggemeyer@googlemail.com
      </a>
    </p>

  </section>

  <section class="block">

    <h2>Verantwortlich für den Inhalt nach § 18 Abs. 2 MStV</h2>

    <p>
      Maik Brüggemeyer<br />
      Anschrift wie oben.
    </p>

  </section>

</section>

</BaseLayout>

<style>

.hero{
  padding:7rem var(--page-padding) 5rem;
  border-bottom:1px solid var(--color-border);
}

h1{
  margin:0;
  font-size:clamp(5rem,11vw,10rem);
  font-weight:400;
  line-height:.85;
  letter-spacing:-.055em;
}

.content{
  width:min(100% - 3rem,840px);
  margin:0 auto;
  padding:5rem 0 7rem;
}

.block{
  margin-bottom:4rem;
}

.block h2{
  margin:0 0 1.5rem;
  font-family:var(--font-sans);
  font-size:.72rem;
  letter-spacing:.18em;
  text-transform:uppercase;
  color:var(--color-muted);
  font-weight:500;
}

.block p{
  margin:0;
  font-size:1.4rem;
  line-height:1.7;
}

.block a{
  color:inherit;
  text-decoration:none;
}

.block a:hover{
  opacity:.65;
}

@media (max-width:900px){

.hero{
  padding:5rem 1.5rem 4rem;
}

.content{
  width:min(100% - 3rem,760px);
}

.block p{
  font-size:1.2rem;
}

}

</style>